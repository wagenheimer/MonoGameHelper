<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Wagenheimer.MonoGameHelper.Gum</PackageId>
    <Version>1.0.1</Version>
    <Authors>Wagenheimer</Authors>
    <Company>Green Sauce Games</Company>
    <Description>Gum UI extensions for MonoGame: dynamic gradient and shadow font materials (via KernSmith), automatic atlas binding, and UI utilities.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wagenheimer/MonoGameHelper</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wagenheimer.MonoGameHelper\Wagenheimer.MonoGameHelper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="Gum.MonoGame" Version="2026.10.1.1" />
    <PackageReference Include="KernSmith.MonoGameGum" Version="2026.10.1.1" />
  </ItemGroup>

</Project>
